{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggaction.github.io/ggaction/schemas/task-packet.schema.json",
  "title": "ggaction compact task packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "query",
    "matchedConstraints",
    "actionPlan",
    "exactCalls",
    "unresolved",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "query": { "type": "string", "minLength": 1, "maxLength": 500 },
    "matchedConstraints": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 100 }
    },
    "actionPlan": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "id",
          "kind",
          "name",
          "constraints",
          "requiredOptions",
          "signature",
          "route"
        ],
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "id": { "type": "string", "minLength": 3 },
          "kind": { "enum": ["action", "runtime"] },
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
          "constraints": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "requiredOptions": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*$" }
          },
          "signature": { "type": "string", "minLength": 8 },
          "route": { "type": "string", "pattern": "^/reference/" }
        }
      }
    },
    "exactCalls": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 3, "maxLength": 700 }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint", "reason"],
        "properties": {
          "constraint": { "type": "string", "minLength": 3 },
          "reason": { "type": "string", "minLength": 10, "maxLength": 240 }
        }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "name", "route"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "kind": { "enum": ["action", "runtime"] },
          "name": { "type": "string", "minLength": 2 },
          "route": { "type": "string", "pattern": "^/reference/" }
        }
      }
    }
  }
}
