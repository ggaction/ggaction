{
  "schemaVersion": 3,
  "name": "filterData",
  "layer": "user-facing",
  "domain": "core",
  "summary": "Create an immutable named dataset using a field filter or a strict boolean expression predicate.",
  "signature": "filterData(options: TargetedOptions<FilterDataOptions>): ChartProgram;",
  "intents": [
    "filter data",
    "filter",
    "retain matching",
    "chart setup",
    "data and scales",
