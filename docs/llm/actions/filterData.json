    ],
    "allowsEmpty": true
  },
  "options": [
    {
      "name": "id",
      "required": true,
      "type": "string"
    },
    {
      "name": "source",
      "required": false,
      "type": "string | undefined"
    },
    {
      "name": "where",
      "required": false,
      "type": "ComputedExpressionV2 | undefined"
    },
    {
      "name": "field",
      "required": false,
      "type": "string | undefined"
    },
    {
      "name": "nulls",
      "required": false,
      "type": "\"exclude\" | \"include\" | undefined"
    },
    {
      "name": "oneOf",
      "required": false,
      "type": "readonly [DatasetScalar, ...DatasetScalar[]] | undefined"
    },
    {
      "name": "noneOf",
      "required": false,
      "type": "readonly [DatasetScalar, ...DatasetScalar[]] | undefined"
    },
    {
      "name": "predicate",
      "required": false,
      "type": "FilterComparison | undefined"
    },
    {
      "name": "range",
      "required": false,
      "type": "FilterRange | undefined"
    },
    {
      "name": "target",
      "required": false,
      "type": "ActionTargetList | ScopedActionTarget"
    }
  ],
  "callPatterns": [
    "filterData({ id, source?, where })",
    "filterData({ id, source?, field, oneOf | noneOf | predicate | range, nulls? })"
  ],
  "snippet": "program.filterData({ id: \"filtered\", field: \"value\", predicate: { op: \"gt\", value: 0 } })",
  "errors": [
    {
      "error": "The where predicate is combined with field filter options, or a field mode is missing.",
      "fix": "Supply only where, or supply field and exactly one of oneOf, noneOf, predicate, or range."
