      "source dataset"
    ],
    "owns": [
      "dataset"
    ],
    "idOptions": [
      "id",
      "source",
      "target"
    ]
  },
  "authoringRoles": [
    "H2"
  ],
  "wraps": [
    "createDerivedData"
  ],
  "editableVia": [
    "editFilteredData"
  ],
  "supports": {
    "entryPoints": [
      "default"
    ]
  },
  "units": [],
  "inference": [
