    },
    {
      "name": "target",
      "required": false,
      "type": "ActionTargetList | ScopedActionTarget"
    }
  ],
  "callPatterns": [
    "reviseData({ source, id, values, target?, schema? })"
  ],
  "snippet": "program.reviseData({ source: \"data-1\", id: \"data-1\", values: [{ category: \"A\", value: 1 }] })",
