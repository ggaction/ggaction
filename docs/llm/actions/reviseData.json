      "source dataset"
    ],
    "owns": [
      "dataset"
    ],
    "idOptions": [
      "source",
      "id",
      "target"
    ]
  },
  "authoringRoles": [
    "H3"
  ],
  "wraps": [
    "createData"
  ],
  "editableVia": [],
  "supports": {
    "entryPoints": [
      "default"
    ]
  },
  "units": [],
