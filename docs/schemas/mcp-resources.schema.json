{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggaction.github.io/ggaction/schemas/mcp-resources.schema.json",
  "title": "ggaction bounded MCP resource catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageVersion", "overview", "recipes", "docs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "packageVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "text"],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 120 },
        "text": { "type": "string", "minLength": 40, "maxLength": 3000 }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "summary", "query"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 20, "maxLength": 300 },
          "query": { "type": "string", "minLength": 3, "maxLength": 500 }
        }
      }
    },
    "docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "route", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 120 },
          "route": { "type": "string", "pattern": "^/" },
          "text": { "type": "string", "minLength": 40, "maxLength": 3000 }
        }
      }
    }
  }
}
